{
  "version": 1,
  "checkpoints": {
    "work-start": {
      "loops": [
        "daily-plan-triage"
      ],
      "strict": false,
      "debounce_minutes": 30,
      "escalate_after": 3
    },
    "pre-finish": {
      "loops": [
        "doc-hygiene"
      ],
      "strict": true,
      "debounce_minutes": 0,
      "escalate_after": 3
    },
    "post-finish": {
      "loops": [
        "doc-hygiene"
      ],
      "strict": false,
      "debounce_minutes": 0,
      "escalate_after": 3
    },
    "experiment-check": {
      "loops": [
        "experiment-monitor"
      ],
      "strict": false,
      "debounce_minutes": 30,
      "escalate_after": 3
    }
  }
}