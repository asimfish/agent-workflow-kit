#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ ! -f tools/agentctl.py ]; then
  echo "agentctl hook failed: tools/agentctl.py not found" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! python3 tools/agentctl.py check --mode pre-push --commit-range "$range"; then
    status=1
  fi
done

exit "$status"
