#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
REMOTE_NAME="${1:-origin}"
ZERO_SHA="0000000000000000000000000000000000000000"

if [ ! -f tools/agentctl.py ]; then
  echo "agentctl hook failed: tools/agentctl.py not found" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    base_ref=""
    for candidate in "$REMOTE_NAME/main" "$REMOTE_NAME/master" "origin/main" "origin/master"; do
      if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
        base_ref="$candidate"
        break
      fi
    done
    if [ -n "$base_ref" ] && base="$(git merge-base "$local_sha" "$base_ref" 2>/dev/null)"; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  if ! python3 tools/agentctl.py check --mode pre-push --commit-range "$range" \
    --published-remote "$REMOTE_NAME"; then
    status=1
  fi
done

exit "$status"
