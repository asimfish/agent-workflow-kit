{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 tools/agent_workflow_hook.py session-start",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "python3 tools/agent_workflow_hook.py pre-tool-use",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 tools/agent_workflow_hook.py pre-tool-use",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 tools/agent_workflow_hook.py pre-tool-use",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 tools/agent_workflow_hook.py stop",
        "timeout": 30
      }
    ]
  }
}
